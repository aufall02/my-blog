---
const allPosts = await Astro.glob("../pages/posts/*.md");
const sortedPosts = allPosts.sort(
    (a, b) =>
        new Date(b.frontmatter.date).getTime() -
        new Date(a.frontmatter.date).getTime(),
);

const currentPath = Astro.url.pathname;
const currentIndex = sortedPosts.findIndex((post) => {
    const postUrl = post.url?.endsWith("/") ? post.url : post.url + "/";
    const normalizedPath = currentPath.endsWith("/")
        ? currentPath
        : currentPath + "/";
    return postUrl === normalizedPath;
});

const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const prevPost =
    currentIndex < sortedPosts.length - 1
        ? sortedPosts[currentIndex + 1]
        : null;

const { frontmatter } = Astro.props;
const defaultTitle =
    "Aufal Marom - Backend Engineer & System Integration Developer";
const defaultDescription =
    "Aufal Marom is an independent backend engineer and system integration developer from Indonesia. Explore practical articles, experiments, and technical write-ups.";
const defaultKeywords =
    "aufal marom, aufal marom backend engineer, aufal system integration, aufal developer, software engineer indonesia, backend developer, web development";

const pageTitle = frontmatter?.title
    ? `${frontmatter.title} | Aufal Marom`
    : defaultTitle;
const pageDescription = frontmatter?.description || defaultDescription;
const pageKeywords = Array.isArray(frontmatter?.keywords)
    ? frontmatter.keywords.join(", ")
    : frontmatter?.keywords || defaultKeywords;
const canonicalUrl = Astro.url.href;
const ogImage = frontmatter?.image
    ? new URL(frontmatter.image, Astro.url).href
    : new URL("/og-image.jpg", Astro.url).href;
const ogType = frontmatter?.date ? "article" : "website";

const websiteSchema = {
    "@type": "WebSite",
    "@id": "https://ngecode.id/#website",
    url: "https://ngecode.id/",
    name: "Aufal Marom",
    inLanguage: "id-ID",
};

const personSchema = {
    "@type": "Person",
    "@id": "https://ngecode.id/#person",
    name: "Aufal Marom",
    url: "https://ngecode.id/",
    jobTitle: "Backend Engineer and System Integration Developer",
    sameAs: [
        "https://github.com/aufall02",
        "https://www.linkedin.com/in/aufall",
        "https://www.facebook.com/aufall02/",
    ],
};

const articleSchema = frontmatter?.date
    ? {
          "@type": "Article",
          headline: frontmatter?.title || defaultTitle,
          description: pageDescription,
          datePublished: frontmatter.date,
          dateModified: frontmatter.date,
          author: { "@id": "https://ngecode.id/#person" },
          mainEntityOfPage: canonicalUrl,
          ...(ogImage ? { image: [ogImage] } : {}),
      }
    : null;

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        websiteSchema,
        personSchema,
        ...(articleSchema ? [articleSchema] : []),
    ],
};

const normalizedPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = normalizedPathname === "/";
const isBlogs = normalizedPathname === "/posts";

const formatDate = (dateString: string) => {
    if (!dateString) return "";
    const d = new Date(dateString);
    return d.toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
    });
};
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalUrl} />

        <!-- General SEO -->
        <meta name="author" content="Aufal Marom" />
        <meta name="robots" content="index, follow" />
        <meta name="theme-color" content="#ffffff" />
        <meta name="keywords" content={pageKeywords} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        {ogImage && <meta property="og:image" content={ogImage} />}

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalUrl} />
        <meta property="twitter:title" content={pageTitle} />
        <meta property="twitter:description" content={pageDescription} />
        {ogImage && <meta property="twitter:image" content={ogImage} />}

        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
        <style is:global>
            :root {
                --system-fonts:
                    system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
                    Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans",
                    "Helvetica Neue", sans-serif;
                --code-fonts:
                    ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
                    monospace;
                --text-color: #222;
                --link-color: #0000ee;
                --nav-link-color: #551a8b;
                --bg-color: #fff;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: var(--system-fonts);
                color: var(--text-color);
                background-color: var(--bg-color);
                max-width: 650px;
                margin: 0 auto;
            }

            h1,
            h2,
            h3 {
                line-height: 1.2;
                color: #000;
            }

            a {
                color: var(--link-color);
                text-decoration: underline;
            }

            a:hover {
                color: #ff4500;
            }

            code {
                font-family: var(--code-fonts);
                background: #f4f4f4;
                padding: 0.2em 0.4em;
                border-radius: 4px;
                font-size: 0.9em;
            }

            pre {
                background: #f8f8f8;
                padding: 15px;
                border-radius: 8px;
                overflow-x: auto;
                border: 1px solid #eee;
            }

            pre code {
                background: none;
                padding: 0;
            }

            img {
                max-width: 100%;
                height: auto;
                border-radius: 8px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin: 1.5rem 0;
                overflow-x: auto;
                display: block;
                min-width: 100%;
            }

            th,
            td {
                padding: 12px 14px;
                border: 1px solid #e0e0e0;
                text-align: left;
                vertical-align: top;
            }

            thead th {
                background: #f4f4f4;
                font-weight: 600;
            }

            tbody tr:nth-child(odd) {
                background: #fafafa;
            }

            .post-content {
                width: 100%;
                overflow-x: auto;
            }

            .post-content table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                min-width: 100%;
            }

            .post-content table tr {
                border-top: 1px solid #e9e9e9;
            }

            .post-content table td,
            .post-content table th {
                white-space: normal;
                word-break: break-word;
            }

            .post-content table th {
                white-space: nowrap;
            }

            .post-content table th:first-child,
            .post-content table td:first-child {
                width: 16%;
            }

            .post-content table th:nth-child(2),
            .post-content table td:nth-child(2) {
                width: 14%;
            }

            .post-content table th:nth-child(3),
            .post-content table td:nth-child(3) {
                width: 18%;
            }

            .post-content table th:nth-child(4),
            .post-content table td:nth-child(4) {
                width: 28%;
            }

            .post-content table th:nth-child(5),
            .post-content table td:nth-child(5) {
                width: 24%;
            }

            .header-content {
                position: relative;
                /*margin-top: 1rem;*/
                display: flex;
                flex-direction: column;
            }

            .header-date {
                align-self: flex-end;
                font-size: 1.1rem;
                color: #333;
                font-weight: 500;
                margin-bottom: -10px;
            }

            .post-title {
                /*font-size: 2.8rem;*/
                /*font-weight: ;*/
                line-height: 1.1;
                /*margin-top: 10px;*/
                letter-spacing: -0.03em;
                color: #000;
                text-decoration: none;
            }

            .nav-back {
                display: block;
                margin-bottom: 20px;
                color: #666;
                text-decoration: none;
                font-size: 0.9rem;
            }

            main {
                margin-top: 1rem;
            }

            .post-footer {
                margin-top: 100px;
                padding-top: 20px;
                font-size: 1.1rem;
                font-style: italic;
                color: #333;
            }

            .footer-nav {
                margin-top: 40px;
                border-top: 1px solid #eee;
                padding-top: 20px;
                font-style: normal;
            }

            .nav-links {
                display: flex;
                justify-content: space-between;
                gap: 20px;
            }

            .prev,
            .next {
                max-width: 45%;
            }

            .next {
                text-align: right;
                margin-left: auto;
            }

            .footer-nav a {
                color: var(--nav-link-color);
                text-decoration: underline;
                font-size: 1rem;
            }

            .fallback-link {
                display: block;
                margin-top: 10px;
            }

            /* --- Top Navigation Styles --- */
            .top-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1.5rem 0 1rem 0;
            }

            .top-nav h2 {
                margin: 0;
            }

            .nav-left {
                display: flex;
                align-items: baseline;
                gap: 1.5rem;
            }

            .profile-logo {
                width: 40px;
                height: 40px;
                object-fit: cover;
                display: block;
                transition: transform 0.2s ease;
                border-radius: 0;
            }

            .profile-logo:hover {
                transform: scale(1.05);
            }

            .logo-link {
                text-decoration: none;
                display: block;
            }

            .logo-link:hover {
                text-decoration: none;
            }

            .site-name {
                font-size: 1.25rem;
                font-weight: 800; /* Cetak tebal */
                color: #000;
                text-decoration: none; /* Hilangkan garis bawah di nama */
            }

            .site-name:hover {
                color: #000;
                text-decoration: none;
            }

            .main-menu {
                display: flex;
                gap: 1rem; /* Jarak antar menu (About & Blog) */
            }

            .main-menu a {
                color: var(--link-color); /* Biru klasik */
                text-decoration: underline;
                font-size: 1.05rem;
            }

            figcaption {
                text-align: center;
                font-size: 0.9rem;
                color: #666;
                margin-top: 8px;
                font-style: italic;
            }

            .visually-hidden {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }
        </style>
    </head>
    <body>
        <header class="post-header">
            <div class="top-nav">
                <div class="nav-left">
                    <h2>Aufal marom</h2>
                    <nav class="main-menu">
                        <a href="/">About</a>
                        <a href="/posts">Blog</a>
                    </nav>
                </div>
                <a
                    href="https://www.linkedin.com/in/aufall/"
                    class="logo-link"
                    aria-label="LinkedIn"
                    title="Jangan Di Klik!!!"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        src="/logo.jpg"
                        alt="Aufal Marom"
                        class="profile-logo"
                    />
                </a>
            </div>
            <div class="header-content">
                {
                    frontmatter?.date && (
                        <span class="header-date">
                            {formatDate(frontmatter.date)}
                        </span>
                    )
                }
                {frontmatter?.title && <h2>{frontmatter.title}</h2>}
            </div>
        </header>

        <main>
            <div class="post-content">
                <slot />
            </div>
        </main>

        {
            !isHome && !isBlogs && (
                <footer class="post-footer">
                    <p>
                        Please{" "}
                        <a href="mailto:aufaluzumaki@gmail.com">contact me</a>{" "}
                        if you have questions or found issues in this post.
                    </p>

                    <div class="footer-nav">
                        <div class="nav-links">
                            {prevPost && (
                                <div class="prev">
                                    <a href={prevPost.url}>
                                        ← {prevPost.frontmatter.title}
                                    </a>
                                </div>
                            )}
                            {nextPost && (
                                <div class="next">
                                    <a href={nextPost.url}>
                                        {nextPost.frontmatter.title} →
                                    </a>
                                </div>
                            )}
                        </div>

                        {/* Link fallback jika artikel cuma ada 1 */}
                        {!prevPost && !nextPost && (
                            <a href="/posts" class="fallback-link">
                                ← Kembali ke Kumpulan Tulisan
                            </a>
                        )}
                    </div>
                </footer>
            )
        }
    </body>
</html>
